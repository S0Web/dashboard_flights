# À copier dans  .streamlit/secrets.toml  (et NE PAS committer ce fichier sur GitHub)
# Valeurs à récupérer dans Supabase : bouton vert "Connect" > onglet "Connection String"
# > "Session pooler" (compatible IPv4)

[connections.supabase]
dialect  = "postgresql"
driver   = "psycopg2"
host     = "aws-…pooler.supabase.com"   # host du Session pooler (vérifie aws-0 / aws-1 et la région)
port     = 5432
database = "postgres"
username = "postgres.rztrzvfauvooicxfxihq"                    # ex. postgres.rztrzvfauvooicxfxihq
password = "TON_MOT_DE_PASSE_DB"
query    = { sslmode = "require" }
